# =============================================================================
# Recruiter Autopilot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://recruiter:recruiter_pass@postgres:5432/recruiter_autopilot
DATABASE_URL_SYNC=postgresql://recruiter:recruiter_pass@postgres:5432/recruiter_autopilot

# -----------------------------------------------------------------------------
# Redis (Celery Broker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Greenhouse Integration
# -----------------------------------------------------------------------------
# Harvest API key from Greenhouse > Configure > Dev Center > API Credential Management
GREENHOUSE_API_KEY=your_harvest_api_key_here

# Webhook secret from Greenhouse > Configure > Dev Center > Web Hooks
GREENHOUSE_WEBHOOK_SECRET=your_webhook_secret_here

# User ID to use for On-Behalf-Of header (required for write operations)
# Find this in Greenhouse > Configure > Users > click user > ID in URL
GREENHOUSE_ON_BEHALF_OF=12345

# Base URL for Harvest API
GREENHOUSE_API_BASE_URL=https://harvest.greenhouse.io/v1

# -----------------------------------------------------------------------------
# Microsoft Graph (Outlook Email)
# -----------------------------------------------------------------------------
# Azure AD App Registration details
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_client_id
MS_CLIENT_SECRET=your_client_secret

# Mailbox to send from (can be shared mailbox or user mailbox)
MS_MAILBOX=recruiting@yourcompany.com

# Graph API scopes (for delegated auth flow)
# For application permissions, these are configured in Azure AD
MS_GRAPH_SCOPES=Mail.Send,Calendars.ReadWrite

# -----------------------------------------------------------------------------
# Scoring Configuration
# -----------------------------------------------------------------------------
# Minimum score to auto-advance to next stage
SCORE_THRESHOLD_ADVANCE=75

# Maximum score for auto-rejection (below this = reject)
SCORE_THRESHOLD_REJECT=25

# Scores between reject and this threshold go to human review
LOW_CONFIDENCE_THRESHOLD=50

# Path to scoring rubric YAML file
SCORING_RUBRIC_PATH=config/scoring_rubric.yaml

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Secret key for session management
SECRET_KEY=change-this-to-a-secure-random-string

# Enable debug mode (never in production!)
DEBUG=true

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# Admin UI
# -----------------------------------------------------------------------------
# Basic auth for admin endpoints (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
