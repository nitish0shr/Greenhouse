# Recruiter Autopilot - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-string

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruiter_autopilot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# CELERY
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=default

# =============================================================================
# GREENHOUSE API
# =============================================================================
# Get your API key from: Greenhouse > Configure > Dev Center > API Credential Management
GREENHOUSE_API_KEY=your-greenhouse-api-key
# Webhook secret from: Configure > Dev Center > Web Hooks
GREENHOUSE_WEBHOOK_SECRET=your-webhook-secret
GREENHOUSE_API_BASE_URL=https://harvest.greenhouse.io/v1
GREENHOUSE_RATE_LIMIT_PER_SECOND=50
GREENHOUSE_RETRY_MAX_ATTEMPTS=3
GREENHOUSE_RETRY_BASE_DELAY=1.0

# =============================================================================
# MICROSOFT GRAPH / OUTLOOK
# =============================================================================
# Register an app in Azure AD: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
# The shared mailbox email address to send from
MS_SHARED_MAILBOX=recruiting@yourcompany.com
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# =============================================================================
# EMAIL SETTINGS
# =============================================================================
EMAIL_FROM_NAME=Recruiting Team
EMAIL_REPLY_TO=recruiting@yourcompany.com

# =============================================================================
# WEBHOOK SETTINGS
# =============================================================================
# Your public URL for receiving webhooks (must be HTTPS in production)
WEBHOOK_BASE_URL=https://your-domain.com

# =============================================================================
# SLA SETTINGS (in hours)
# =============================================================================
SLA_INGESTED_TO_ACTIONED=24
SLA_CONTACTED_TO_RESPONDED=72
SLA_SCHEDULED_TO_INTERVIEWED=168
SLA_INTERVIEWED_TO_DECISION=48
SLA_SCORECARD_REMINDER_HOURS=24
SLA_SCORECARD_ESCALATION_HOURS=48

# =============================================================================
# SCORING SETTINGS
# =============================================================================
RUBRICS_DIRECTORY=config/rubrics
DEFAULT_CONFIDENCE_THRESHOLD=0.7
AUTO_REJECT_ENABLED=false
NEEDS_REVIEW_ON_LOW_CONFIDENCE=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
MOCK_MODE=false  # Use mocked APIs for testing
DRY_RUN=false    # Log actions without executing
ENABLE_AUTO_SCHEDULING=true
ENABLE_AUTO_REJECTION=false  # Disabled by default for safety
ENABLE_SCORECARD_CHASING=true
ENABLE_SLA_MONITORING=true

# =============================================================================
# ADMIN UI
# =============================================================================
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
